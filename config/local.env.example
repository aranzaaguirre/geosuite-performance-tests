# Plantilla versionable. Copiar a un archivo *.env privado por ambiente y
# asignarle permisos 600. No colocar secretos en este archivo.

# Origen público, sin diagonal final. Usar HTTPS en Nimbus e IDCE.
TEST_ENV_NAME=local
BASE_URL=

# Aprovisionamiento administrativo de cuentas de prueba. La contraseña
# administrativa nunca se guarda aquí; se solicita de forma oculta.
KEYCLOAK_ADMIN_MODE=docker
KEYCLOAK_ADMIN_URL=
KEYCLOAK_DOCKER_SERVICE=keycloak
KEYCLOAK_REALM=
KC_ADMIN_USERNAME=
KC_ADMIN_REALM=master

# Prefijos de los servicios
ADMIN_BASE=/admin
APP_BASE=/app
API_BASE=/api/v2

# Emisor y cliente OIDC utilizados por el módulo administrativo.
KEYCLOAK_CLIENT_ID=
OIDC_ISSUER=

# Rutas de sesión del módulo administrativo
AUTH_CSRF_PATH=/admin/api/auth/csrf
AUTH_SIGNIN_PATH=/admin/api/auth/signin/keycloak
AUTH_SESSION_PATH=/admin/api/auth/session
AUTH_CALLBACK_URL=/admin/catalogo

# Endpoint protegido de Django/GeoNode
AUTH_PROTECTED_PATH=/api/v2/account/me/profile/

# Cuenta exclusiva para pruebas. Los valores reales van en el archivo privado.
AUTH_USERNAME=
AUTH_PASSWORD=
# Pool generado por scripts/provision-users.sh. Obligatorio en perfiles
# concurrentes autenticados; la ruta es relativa a lib/session.js.
AUTH_USERS_FILE=

# Máximo de recursos inspeccionados durante el descubrimiento.
DISCOVERY_PAGE_SIZE=100

# Perfil: functional, baseline, load, stress, spike o recovery.
TEST_PROFILE=functional
# baseline usa VUS/DURATION; los perfiles de rampa usan VUS como objetivo.
PROFILE_VUS=3
PROFILE_DURATION=2m
# Vacío usa el p95 propio de cada escenario.
PROFILE_P95_MS=
PROFILE_STAGE_DURATION=1m
PROFILE_HOLD_DURATION=3m
PROFILE_RECOVERY_DURATION=2m
PROFILE_GRACEFUL_STOP=30s
PROFILE_GRACEFUL_RAMP_DOWN=30s
PROFILE_BASE_VUS=2

# Perfiles que se buscarán en el catálogo
CATALOG_PROFILES=raster,vector,table,pdf,text,remote
# Flujo autenticado validado; false usa la entrada pública /app.
CATALOG_AUTHENTICATED=true

# false permite omitir perfiles inexistentes sin invalidar el escenario.
FAIL_IF_PROFILE_MISSING=false

# Activar solo cuando el endpoint de estilos esté validado.
INCLUDE_STYLES=false

# GeoServer y mapas
GEOSERVER_BASE=/gs

# Vacío: selecciona automáticamente un mapa con capas
MAP_ID=

# Flujo autenticado validado; false permite comprobar acceso público.
MAP_AUTHENTICATED=true

# Descubrimiento y límites de seguridad
MAP_DISCOVERY_PAGE_SIZE=100
MAP_FAIL_IF_MISSING=true
MAP_MAX_LAYERS=3

# Solicitud representativa de teselas
MAP_TILE_ZOOM=10

# Dimensiones de WMS GetMap y GetFeatureInfo
MAP_WIDTH=800
MAP_HEIGHT=600
MAP_FORMAT=image/png

# Validaciones complementarias
MAP_VALIDATE_FALLBACK=true
MAP_VALIDATE_INTERACTION=true

# analyze elimina el job; full crea un dataset persistente.
UPLOAD_MODE=analyze
# Usa el proxy autenticado del frontend administrativo.
UPLOAD_USE_GNOXY=true
# Ruta relativa al directorio scenarios/ durante la resolución de open().
UPLOAD_FILE=../data/upload-pilot.csv
UPLOAD_FILENAME=geosuite_k6_upload_pilot.csv
# Frecuencia y límite del polling asíncrono del importador.
UPLOAD_POLL_INTERVAL_SECONDS=1
UPLOAD_POLL_TIMEOUT_SECONDS=60
UPLOAD_GEO_PREVIEW=true
# Solo aplica automáticamente a jobs no importados en modo analyze.
UPLOAD_CLEANUP_JOB=true
# Finaliza metadatos únicamente en modo full.
UPLOAD_FINALIZE=false
# En full comprueba la capa creada mediante WMS y WFS.
UPLOAD_VERIFY_GEOSERVER=true
UPLOAD_GEOSERVER_TIMEOUT_SECONDS=90
